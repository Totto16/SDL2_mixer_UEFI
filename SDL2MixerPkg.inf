[Defines]
  INF_VERSION = 1.25
  BASE_NAME = SDL2MixerLib
  FILE_GUID = 057e5941-7c58-4aef-8ba4-60240f16dfa8
  MODULE_TYPE = BASE
  VERSION_STRING = 2.8.2
  LIBRARY_CLASS = LibSDL2Mixer|UEFI_APPLICATION 

[Sources]
  src/codecs/load_aiff.c
  src/codecs/load_voc.c
  src/codecs/mp3utils.c
  src/codecs/music_cmd.c
  src/codecs/music_drflac.c
  src/codecs/music_minimp3.c
  src/codecs/music_wav.c
  src/effect_position.c
  src/effect_stereoreverse.c
  src/effects_internal.c
  src/mixer.c
  src/music.c
  src/utils.c


[Packages]
  MdePkg/MdePkg.dec
  StdLib/StdLib.dec
  SDL2Pkg/SDL2Pkg.dec

[LibraryClasses]
[LibraryClasses]
# MdePkg
  UefiLib
# StdLib
  LibC
  LibCType
  LibLocale
  LibMath
  LibSignal
  LibStdio
  LibStdLib
  LibString
  LibTime
  LibUefi
  LibWchar
  LibGdtoa
# SDL2Pkg
  LibSDL2

[BuildOptions]
  *_*_*_CC_FLAGS  = -std=c11

  *_*_*_CC_FLAGS = -D__UEFI__
  *_*_*_CC_FLAGS = "-DEFIAPI=__attribute__((ms_abi))"
  
  *_*_*_CC_FLAGS = -fvisibility=hidden
  *_*_*_CC_FLAGS = -D_REENTRANT
  *_*_*_CC_FLAGS = -pthread
  *_*_*_CC_FLAGS = -I$(MODULE_DIR)/include
  *_*_*_CC_FLAGS = -I$(MODULE_DIR)/src
  *_*_*_CC_FLAGS = -I$(MODULE_DIR)/src/codecs

  *_*_*_CC_FLAGS = "-DMUSIC_WAV" "-DMUSIC_MP3_MINIMP3"
  *_*_*_CC_FLAGS = -I$(WORKSPACE)/StdLib/Include
  *_*_*_CC_FLAGS = -Wno-unused-variable

[BuildOptions.X64]
  *_*_*_CC_FLAGS = -I$(WORKSPACE)/StdLib/Include/X64
