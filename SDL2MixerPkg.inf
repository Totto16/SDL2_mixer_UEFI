[Defines]
  INF_VERSION = 1.25
  BASE_NAME = SDL2MixerLib
  FILE_GUID = 057e5941-7c58-4aef-8ba4-60240f16dfa8
  MODULE_TYPE = BASE
  VERSION_STRING = 2.8.2
  LIBRARY_CLASS = LibSDL2Mixer|UEFI_APPLICATION 

[Sources]
  src/mixer.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiLib
  LibC

[BuildOptions]
  *_*_*_CC_FLAGS  = -std=c11

  *_*_*_CC_FLAGS = -D__UEFI__
  *_*_*_CC_FLAGS = "-DEFIAPI=__attribute__((ms_abi))"
  
  *_*_*_CC_FLAGS = -fvisibility=hidden
  *_*_*_CC_FLAGS = -D_REENTRANT
  *_*_*_CC_FLAGS = -pthread
  *_*_*_CC_FLAGS = -I$(MODULE_DIR)/include
  *_*_*_CC_FLAGS = -I$(MODULE_DIR)/src

  *_*_*_CC_FLAGS = -I$(WORKSPACE)/StdLib/Include

[BuildOptions.X64]
  *_*_*_CC_FLAGS = -I$(WORKSPACE)/StdLib/Include/X64
